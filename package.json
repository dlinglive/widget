{
  "name": "@dlinglive/widget",
  "version": "0.7.0",
  "description": "dlinglive 라이브 위젯 로더와 React 컴포넌트",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlinglive/widget.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "README.md",
    "CHANGELOG.md",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "oxlint --deny-warnings . && biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:ci": "pnpm format:check && pnpm lint && pnpm typecheck"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "oxlint": "1.94.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "homepage": "https://github.com/dlinglive/widget#readme",
  "bugs": {
    "url": "https://github.com/dlinglive/widget/issues"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome"
    ]
  }
}
